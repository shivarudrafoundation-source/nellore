# ==============================================================================
# SIVA RUDRA FOUNDATION — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local/server setup. NEVER COMMIT ACTUAL PRODUCTION SECRETS!
# ==============================================================================

# Node Environment ('development' | 'staging' | 'production')
NODE_ENV=production
PORT=4000

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Runtime pooled transaction connection string (e.g. Supabase connection pooler port 6543/5432)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=20"

# Direct unpooled connection string (required for Prisma migrations and schema push)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. REDIS CONFIGURATION (Upstash / Managed Redis)
# ------------------------------------------------------------------------------
# Server-side only connection URL for multi-instance realtime Pub/Sub distribution
REDIS_URL="rediss://default:[REDIS-PASSWORD]@[REDIS-HOST]:6379"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Minimum 32-character random cryptographic secret for Access Tokens (HMAC-SHA256)
JWT_SECRET="generate-a-cryptographically-secure-random-secret-key-at-least-32-chars"

# Minimum 32-character random cryptographic secret for Refresh Tokens
JWT_REFRESH_SECRET="generate-another-distinct-secure-random-secret-key-for-refresh"

# 2FA / TOTP encryption secret for Admin Two-Factor Authentication
TOTP_ENCRYPTION_KEY="generate-a-32-byte-hex-or-base64-encryption-key"

# HTTPOnly Cookie Domain Scope (e.g., '.sivarudrafoundation.com' or leave unset for host-only)
COOKIE_DOMAIN=""

# ------------------------------------------------------------------------------
# 4. OFFICIAL APPLICATION DOMAINS & CORS ORIGINS
# ------------------------------------------------------------------------------
# Public Website (User entry point)
PUBLIC_URL="https://sivarudrafoundation.com"

# Admin Orchestration Panel
ADMIN_URL="https://admin.sivarudrafoundation.com"

# Judge Scoring Console
JUDGES_URL="https://judges.sivarudrafoundation.com"

# Stage LED Display Screen
STAGE_URL="https://stage.sivarudrafoundation.com"

# Contestant Self-Service Portal
CONTESTANT_URL="https://my.sivarudrafoundation.com"

# Backend REST & WebSocket Gateway
API_URL="https://api.sivarudrafoundation.com"
WS_URL="wss://api.sivarudrafoundation.com"

# ------------------------------------------------------------------------------
# 5. FRONTEND CLIENT-ACCESSIBLE ENVIRONMENT VARIABLES (Next.js NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="https://api.sivarudrafoundation.com"
NEXT_PUBLIC_WS_URL="wss://api.sivarudrafoundation.com"

# ------------------------------------------------------------------------------
# 6. SUPABASE STORAGE & CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJh...[SUPABASE-ANON-PUBLIC-KEY]"

# Server-side only: never expose service role key to frontend bundles
SUPABASE_SERVICE_ROLE_KEY="eyJh...[SUPABASE-SERVICE-ROLE-KEY]"
SUPABASE_DOCUMENTS_BUCKET="srf-documents"
